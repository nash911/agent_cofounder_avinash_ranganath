node_modules/
.npm-cache/
.env
.env.*
!.env.example
*.log
/result.json

artifacts/*
!artifacts/.gitkeep
output/*
!output/.gitkeep

app-template/node_modules/
app-template/dist/
coverage/

# Project specific
.hunknote/
.idea/
temp/

# Blind-evaluation material (BUILD_PLAN §4). Holdout ideas, the snapshots a
# run leaves behind and the eval reports must never be tracked: a committed
# holdout is a holdout the pipeline has effectively seen. `harness/eval.py`
# refuses paths inside the repository, and this line is the second lock.
evals/

# Pi writes credentials into the config directory on /login; the committed
# .pi-agent/ holds only models.json and settings.json.
.pi-agent/auth.json
.pi-agent/models-store.json

# Python bytecode from the harness package (PYTHONDONTWRITEBYTECODE=1 in judged runs).
__pycache__/
*.py[cod]
