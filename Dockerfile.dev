# Development image: identical to Dockerfile minus the "npm run check" layer,
# which costs ~217s per iteration. Never used for judging.
FROM node:22.19.0-bookworm-slim

WORKDIR /challenge
ENV npm_config_cache=/challenge/.npm-cache

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY app-template/package.json app-template/package-lock.json ./app-template/
RUN npm --prefix app-template ci --ignore-scripts

# The harness orchestrator runs on python3; the base image ships none.
# Installed before "COPY . ." so the npm ci layers above stay cached.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1

COPY . .
RUN mkdir -p output artifacts \
    && chown -R node:node /challenge

EXPOSE 3000
USER node

ENTRYPOINT ["npm", "run", "challenge", "--"]
