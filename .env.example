# The organizer controls these values during official judging.
# Participants may set them locally, but must never commit credentials.
CHALLENGE_PROVIDER=
CHALLENGE_MODEL=
CHALLENGE_THINKING=off
CHALLENGE_TIMEOUT_MS=900000

# Harness agent selection and interpreter (local development).
CHALLENGE_AGENT=python
HARNESS_PYTHON=

# Thinking guard (solution/extensions/thinking-guard.ts). Set to 0 to disable it.
HARNESS_THINKING_GUARD=1

# Local provider configuration. The organizers' own Pi configuration must win in
# the judged environment, so this is never baked into the Docker image and never
# set by harness code.
PI_CODING_AGENT_DIR=/absolute/path/to/repo/.pi-agent  # local development only; must be ABSOLUTE; never set in the judged environment
BERGET_API_KEY=
