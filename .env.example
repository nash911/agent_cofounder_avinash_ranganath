# The organizer controls these values during official judging and may override
# anything set here. Participants may set them locally, but must never commit
# credentials. The values below are the harness defaults, spelled out so the
# judged model is explicit rather than whatever Pi would pick on its own; the
# harness falls back to exactly these when both are unset.
CHALLENGE_PROVIDER=berget
CHALLENGE_MODEL=zai-org/GLM-5.2
CHALLENGE_THINKING=off
CHALLENGE_TIMEOUT_MS=900000

# Harness agent selection and interpreter (local development).
CHALLENGE_AGENT=python
HARNESS_PYTHON=

# Thinking guard (solution/extensions/thinking-guard.ts). Set to 0 to disable it.
HARNESS_THINKING_GUARD=1

# Model-gateway credential (harness.credentials.resolve_api_key(), C3). First
# non-empty of the three below wins; BERGET_API_KEY is the canonical name --
# CHALLENGE_API_KEY and OPENAI_API_KEY are organizer-facing aliases. Only the
# name actually used is ever logged, never the value.
BERGET_API_KEY=
CHALLENGE_API_KEY=
OPENAI_API_KEY=

# Direct-gateway reasoning agents (harness/gateway.py, harness/analyst.py).
# HARNESS_GATEWAY_URL is the model-gateway base URL every direct call targets.
# Set HARNESS_DIRECT=0 to disable the Phase-2 analyst seed call; it never
# blocks the Pi session on failure either way.
HARNESS_GATEWAY_URL=https://api.berget.ai/v1
HARNESS_DIRECT=1

# Local provider configuration. The organizers' own Pi configuration must win
# in the judged environment; the Dockerfile bakes PI_CODING_AGENT_DIR into the
# image (/challenge/.pi-agent) because this track is judged on OUR image, not
# an organizer-controlled one -- but harness *code* itself must never set this
# variable, only the Dockerfile ENV and this file.
#
# Left commented out on purpose: scripts/judge.sh passes this file straight to
# `docker create --env-file .env`, and a live value here would override the
# image's baked-in /challenge/.pi-agent, breaking Pi's provider/model config
# resolution in the judged container. Uncomment only for host-side (non-Docker)
# local development, and only with an ABSOLUTE path.
# PI_CODING_AGENT_DIR=/absolute/path/to/repo/.pi-agent
